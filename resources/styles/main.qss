/* ── Game Card ───────────────────────────────────────────────── */
QFrame#gameCard {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #a5bcda, stop:1 #edf2f8
    );
}

/* QFrame#gameCard:hover {
    background-color: #9B6DFF;
    /* border: 1px solid #7A5ACA; 
} */

