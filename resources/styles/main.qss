/* ════════════════════════════════════════════════════════════════
   TypeMaster — Global QSS Stylesheet
   ════════════════════════════════════════════════════════════════ */

/* ── 自定义顶部标题栏 ──*/
QWidget#m_topBar {
    background: qlineargradient(
    x1:0, y1:0, x2:1, y2:0,
    stop:0 #A9CCE3, stop:1 #96c1dd
    );
}

QLabel#brandLabel {
    color: #000000;
    font-size: 24px;
    background: transparent;
}

QLabel#sloganLabel {
    color: #555;
    font-size: 10px;
    background: transparent;
}

QLabel#yearLabel {
    color: #665d5d;
    font-size: 18px;
    background: transparent;
    padding-right: 4px;
    font-weight: Times New Roman;
}

QLabel#logoLabel {
    background: transparent;
}

QPushButton#minBtn, QPushButton#maxBtn, QPushButton#closeBtn, QPushButton#SetBtn{
    background: transparent;
    color: #000;
    border: none;
    font-size: 14px;
    font-weight: normal;
}
QPushButton#MinBtn:hover, QPushButton#MaxBtn:hover, QPushButton#CloseBtn:hover, QPushButton#SetBtn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

QPushButton#MinBtn:pressed, QPushButton#MaxBtn:pressed, QPushButton#CloseBtn:pressed, QPushButton#SetBtn:pressed {
    background: rgba(255, 255, 255, 0.3);
}

/* ── Central widget (main background) ──*/
QWidget#centralWidget {
    background: #c9d7ea;
}

/* ── Header ── */
/* QWidget#headerWidget {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0   #1A0A3A,
        stop:0.5 #2A0A5A,
        stop:1   #1A0A3A
    );
    border-bottom: 2px solid #4A2090;
} */

QLabel#titleLabel {
    font-size: 20px;
    font-weight: Microsoft YaHei;
    letter-spacing: 3px;
}

QLabel#subtitleLabel {
    font-size: 14px;
    /* color: #B0A0D0; */
    letter-spacing: 1px;
}

/* ── Footer ── */
QWidget#footerWidget {
    background: qlineargradient(
    x1:0, y1:0, x2:1, y2:0,
    stop:0 #A9CCE3, stop:1 #96c1dd
    );
}

QLabel#footerLabel {
    color: #606080;
    font-size: 11px;
} 

/* ── Scroll area ──*/
/* QScrollArea#scrollArea,
QScrollArea#scrollArea > QWidget > QWidget {
    background: transparent;
} */

QWidget#cardsContainer {
    background: #c9d7ea;
}

