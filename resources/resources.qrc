<RCC>
    <!-- Stylesheet  -->
    <qresource prefix="/styles">
        <file alias="main.qss">styles/main.qss</file>
    </qresource>

    <!-- ttf -->
    <qresource prefix="/fonts">
        <file>fonts/ZhiMangXing-Regular.ttf</file>
    </qresource>

    <!--  Common images  -->
    <qresource prefix="/images/Common">
        <file alias="CANCEL.png">images/Common/CANCEL.png</file>
        <file alias="DEFAULT.png">images/Common/DEFAULT.png</file>
        <file alias="MAIN_DLG_BG.png">images/Common/MAIN_DLG_BG.png</file>
        <file alias="MAIN_DLG_EXIT.png">images/Common/MAIN_DLG_EXIT.png</file>
        <file alias="MAIN_DLG_REPLAY.png">images/Common/MAIN_DLG_REPLAY.png</file>
        <file alias="NO.png">images/Common/NO.png</file>
        <file alias="OK.png">images/Common/OK.png</file>
        <file alias="PUBLIC_END.png">images/Common/PUBLIC_END.png</file>
        <file alias="PUBLIC_EXIT.png">images/Common/PUBLIC_EXIT.png</file>
        <file alias="PUBLIC_PAUSE.png">images/Common/PUBLIC_PAUSE.png</file>
        <file alias="PUBLIC_SETUP.png">images/Common/PUBLIC_SETUP.png</file>
        <file alias="PUBLIC_START.png">images/Common/PUBLIC_START.png</file>
        <file alias="SLIDER_BG.png">images/Common/SLIDER_BG.png</file>
        <file alias="SLIDER_SLIDER.png">images/Common/SLIDER_SLIDER.png</file>
        <file alias="YES.png">images/Common/YES.png</file>
        <file alias="logo.png">images/Common/typemaster_logo.png</file>
        <file alias="logo_48.png">images/Common/typemaster_logo_48.png</file>
        <file alias="airplane.png">images/Space/airplane.png</file>
        <file alias="apple.png">images/Apple/APPLE_SMALL.png</file>
    </qresource>

    <!--  Apple game images  -->
    <qresource prefix="/images/Apple">
        <file alias="APPLE_BACKGROUND.png">images/Apple/APPLE_BACKGROUND.png</file>
        <file alias="APPLE_BAD.png">images/Apple/APPLE_BAD.png</file>
        <file alias="APPLE_BASKET.png">images/Apple/APPLE_BASKET.png</file>
        <file alias="APPLE_DLG_BG.png">images/Apple/APPLE_DLG_BG.png</file>
        <file alias="APPLE_DLG_END.png">images/Apple/APPLE_DLG_END.png</file>
        <file alias="APPLE_DLG_NEXT.png">images/Apple/APPLE_DLG_NEXT.png</file>
        <file alias="APPLE_DLG_REPLAY.png">images/Apple/APPLE_DLG_REPLAY.png</file>
        <file alias="APPLE_NORMAL.png">images/Apple/APPLE_NORMAL.png</file>
        <file alias="APPLE_SETUP.png">images/Apple/APPLE_SETUP.png</file>
        <file alias="APPLE_SMALL.png">images/Apple/APPLE_SMALL.png</file>
        <file alias="save.png">images/Apple/save_logo.png</file>
    </qresource>

    <!--  Space game images  -->
    <qresource prefix="/images/Space">
        <file alias="SPACE_BACKGROUND.png">images/Space/SPACE_BACKGROUND.png</file>
        <file alias="SPACE_MAINMENU_BG.png">images/Space/SPACE_MAINMENU_BG.png</file>
        <file alias="SPACE_SHIP.png">images/Space/SPACE_SHIP.png</file>
        <file alias="SPACE_BOMB.png">images/Space/SPACE_BOMB.png</file>
        <file alias="SPACE_START.png">images/Space/SPACE_START.png</file>
        <file alias="SPACE_EXIT.png">images/Space/SPACE_EXIT.png</file>
        <file alias="space.png">images/Space/space_logo.png</file>
    </qresource>

    <!--  Common game sounds  -->
    <qresource prefix="/sounds/Common">
        <file alias="ANIBTN_CLICK.wav">sounds/Common/ANIBTN_CLICK.wav</file>
        <file alias="ANIBTN_ENTER.wav">sounds/Common/ANIBTN_ENTER.wav</file>
        <file alias="BTN_CLICK.wav">sounds/Common/BTN_CLICK.wav</file>
        <file alias="GLIDE.wav">sounds/Common/GLIDE.wav</file>
        <file alias="TYPE.wav">sounds/Common/TYPE.wav</file>
    </qresource>

    <!--  Apple game sounds  -->
    <qresource prefix="/sounds/Apple">
        <file alias="APPLE_BG.wav">sounds/Apple/APPLE_BG.wav</file>
        <file alias="APPLE_IN.wav">sounds/Apple/APPLE_IN.wav</file>
    </qresource>
    
    <!--  Space game sounds  -->
    <qresource prefix="/sounds/Space">    
        <file alias="SPACE_BG.wav">sounds/Space/SPACE_BG.wav</file>
        <file alias="SPACE_BLAST.wav">sounds/Space/SPACE_BLAST.wav</file>
        <file alias="SPACE_PLANEOUT.wav">sounds/Space/SPACE_PLANEOUT.wav</file>
        <file alias="SPACE_SHOOT.wav">sounds/Space/SPACE_SHOOT.wav</file>
        <file alias="SPACE_WORDOUT.wav">sounds/Space/SPACE_WORDOUT.wav</file>
        <file alias="UPGRADE.wav">sounds/Space/UPGRADE.wav</file>
    </qresource>

    


    <!-- ── Translations ──────────────────────────────────────────── -->
    <!-- QM files are auto-generated by qt_add_translations in CMake -->
</RCC>
