<RCC>
    <!-- ── Stylesheet ─────────────────────────────────────────────── -->
    <qresource prefix="/styles">
        <file>styles/main.qss</file>
    </qresource>

    <!-- ── Common images ─────────────────────────────────────────── -->
    <qresource prefix="/images/Common">
        <file alias="CANCEL.png">resources/images/Common/CANCEL.png</file>
        <file alias="DEFAULT.png">resources/images/Common/DEFAULT.png</file>
        <file alias="MAIN_DLG_BG.png">resources/images/Common/MAIN_DLG_BG.png</file>
        <file alias="MAIN_DLG_EXIT.png">resources/images/Common/MAIN_DLG_EXIT.png</file>
        <file alias="MAIN_DLG_REPLAY.png">resources/images/Common/MAIN_DLG_REPLAY.png</file>
        <file alias="NO.png">resources/images/Common/NO.png</file>
        <file alias="OK.png">resources/images/Common/OK.png</file>
        <file alias="PUBLIC_END.png">resources/images/Common/PUBLIC_END.png</file>
        <file alias="PUBLIC_EXIT.png">resources/images/Common/PUBLIC_EXIT.png</file>
        <file alias="PUBLIC_PAUSE.png">resources/images/Common/PUBLIC_PAUSE.png</file>
        <file alias="PUBLIC_SETUP.png">resources/images/Common/PUBLIC_SETUP.png</file>
        <file alias="PUBLIC_START.png">resources/images/Common/PUBLIC_START.png</file>
        <file alias="SLIDER_BG.png">resources/images/Common/SLIDER_BG.png</file>
        <file alias="SLIDER_SLIDER.png">resources/images/Common/SLIDER_SLIDER.png</file>
        <file alias="YES.png">resources/images/Common/YES.png</file>
    </qresource>

    <!-- ── Apple game images ─────────────────────────────────────── -->
    <qresource prefix="/images/Apple">
        <file alias="APPLE_BACKGROUND.png">resources/images/Apple/APPLE_BACKGROUND.png</file>
        <file alias="APPLE_BAD.png">resources/images/Apple/APPLE_BAD.png</file>
        <file alias="APPLE_BASKET.png">resources/images/Apple/APPLE_BASKET.png</file>
        <file alias="APPLE_DLG_BG.png">resources/images/Apple/APPLE_DLG_BG.png</file>
        <file alias="APPLE_DLG_END.png">resources/images/Apple/APPLE_DLG_END.png</file>
        <file alias="APPLE_DLG_NEXT.png">resources/images/Apple/APPLE_DLG_NEXT.png</file>
        <file alias="APPLE_DLG_REPLAY.png">resources/images/Apple/APPLE_DLG_REPLAY.png</file>
        <file alias="APPLE_NORMAL.png">resources/images/Apple/APPLE_NORMAL.png</file>
        <file alias="APPLE_SETUP.png">resources/images/Apple/APPLE_SETUP.png</file>
        <file alias="APPLE_SMALL.png">resources/images/Apple/APPLE_SMALL.png</file>
    </qresource>

    <!-- ── Space game images ─────────────────────────────────────── -->
    <qresource prefix="/images/Space">
        <file alias="SPACE_BACKGROUND.png">resources/images/Space/SPACE_BACKGROUND.png</file>
        <file alias="SPACE_MAINMENU_BG.png">resources/images/Space/SPACE_MAINMENU_BG.png</file>
        <file alias="SPACE_SHIP.png">resources/images/Space/SPACE_SHIP.png</file>
        <file alias="SPACE_BOMB.png">resources/images/Space/SPACE_BOMB.png</file>
        <file alias="SPACE_START.png">resources/images/Space/SPACE_START.png</file>
        <file alias="SPACE_EXIT.png">resources/images/Space/SPACE_EXIT.png</file>
    </qresource>

    <!-- ── Translations ──────────────────────────────────────────── -->
    <!-- QM files are auto-generated by qt_add_translations in CMake -->
</RCC>
